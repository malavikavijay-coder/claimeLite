{
  "name": "claimlite",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "claimlite/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/claimlite",
        "index": "claimlite/src/index.html",
        "main": "claimlite/src/main.ts",
        "tsConfig": "claimlite/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "claimlite/public"
          }
        ],
        "styles": ["claimlite/src/styles.css"],
        "customWebpackConfig": {
          "path": "claimlite/webpack.config.js"
        },
        "commonChunk": false,
        "extractLicenses": false
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "customWebpackConfig": {
            "path": "claimlite/webpack.prod.config.js"
          },
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "options": {
        "port": 4200,
        "liveReload": false,
        "watch": false
      },
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "claimlite:build:production"
        },
        "development": {
          "buildTarget": "claimlite:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "claimlite:build",
        "port": 4200,
        "staticFilePath": "dist/claimlite",
        "spa": true
      }
    }
  }
}
